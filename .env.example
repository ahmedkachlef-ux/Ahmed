# Required for real generation. If empty, the app runs in MOCK mode (deterministic demo BMC).
ANTHROPIC_API_KEY=

# Optional: override default model (defaults to claude-opus-4-7)
# ANTHROPIC_MODEL=claude-opus-4-7

# Optional: effort — low | medium | high | xhigh | max  (default: high)
# ANTHROPIC_EFFORT=high

# Storage root for file-based persistence (default: ./data)
# DATA_DIR=./data

# ---------------------------------------------------------------------------
# Provider priority: OPENROUTER > ANTHROPIC > mock (deterministic demo).
# Only ONE key is required. If neither is set, the app runs in mock mode.
# ---------------------------------------------------------------------------

# --- OpenRouter (free models available) -------------------------------------
# 1. Sign up at https://openrouter.ai/  (no credit card required for free tier)
# 2. Create a key at https://openrouter.ai/keys
# 3. Paste it here:
OPENROUTER_API_KEY=

# Optional: override the model. Default is a free 70B Llama.
# Other solid free options (change if the default is rate-limited):
#   meta-llama/llama-3.3-70b-instruct:free
#   meta-llama/llama-3.1-70b-instruct:free
#   google/gemini-2.0-flash-exp:free
#   mistralai/mistral-nemo:free
#   qwen/qwen-2.5-72b-instruct:free
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: custom attribution headers (shown on OpenRouter leaderboard).
# OPENROUTER_REFERRER=https://your-domain.example

# --- Anthropic (paid, uses claude-opus-4-7) ---------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-7
# ANTHROPIC_EFFORT=high       # low | medium | high | xhigh | max

# --- Storage ----------------------------------------------------------------
# DATA_DIR=./data             # root for file-system persistence
